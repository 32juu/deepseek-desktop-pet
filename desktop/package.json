{
  "name": "deepseek-desktop-pet",
  "productName": "蓝色大肥鱼桌宠",
  "version": "1.0.0",
  "description": "DeepSeek 风格 Windows 轻量桌宠：中英翻译 / 智能对话 / 今日任务 / 定时器 / 笔记总结",
  "main": "src/main/index.js",
  "author": "deepseek-pet",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\"",
    "smoke": "bash ../scripts/smoke.sh",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9"
  },
  "build": {
    "appId": "com.deepseek.desktoppet",
    "productName": "蓝色大肥鱼桌宠",
    "directories": {
      "output": "dist"
    },
    "files": [
      "package.json",
      "src/**/*",
      "renderer/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "蓝色大肥鱼桌宠"
    }
  }
}
