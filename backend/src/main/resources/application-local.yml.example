# 本地覆盖配置示例
#
# 用法：
#   1. 复制本文件为 application-local.yml（该文件已在 .gitignore 中，不会被提交）
#   2. 填入真实数据库密码与 LLM API Key
#   3. 以 --spring.profiles.active=local 启动，或 mvn spring-boot:run -Dspring-boot.run.profiles=local
#
# 切勿把真实密码提交进仓库。
#
# 注意：本文件必须保持**只有一个根级 spring 键**，否则 SnakeYAML 会报
#       "found duplicate key spring" 并导致应用无法启动。

spring:
  datasource:
    username: pet_app
    password: 在这里填数据库密码

  ai:
    openai:
      # 留空即可：不填 Key 后端仍能正常启动，
      # 只有真正发起 AI 对话时才会报错（见 docs/dev-log.md D11）
      api-key: 在这里填 LLM API Key

logging:
  level:
    com.fishpet.pet: DEBUG
